# Vite env for the Dex frontend. Copy to `.env` and adjust.
#
# The values below are the LOCAL DEV shape used by ./run.sh: every backend is
# called directly on its own localhost port, because the Vite dev server runs
# at http://localhost:5173 and each service allows that origin in its own
# .env (WS_ALLOWED_ORIGINS / BOTS_ALLOWED_ORIGINS; the matching engine falls
# back to localhost origins while APP_ENV isn't "production").
#
# PRODUCTION instead routes everything through the Caddy gateway on one
# subdomain (see ../../Caddyfile), which strips the path prefix before
# proxying to each service:
#   VITE_AUTH_API_URL=https://api.bitdx.me/auth
#   VITE_BOTS_API_URL=https://api.bitdx.me/bots
#   VITE_ENGINE_API_URL=https://api.bitdx.me/engine
#   VITE_WS_URL=wss://api.bitdx.me/engine/ws
#   VITE_PREDICTION_API_URL=https://api.bitdx.me/prediction
#   VITE_PREDICTION_WS_URL=wss://api.bitdx.me/prediction/prediction/ws
#   VITE_PROPFIRM_URL=https://api.bitdx.me/propfirm

# Ports (run.sh): engine 8080, backend/auth 8081, bots 8082, prediction 8084,
# propfirm 8090.
VITE_AUTH_API_URL=http://localhost:8081
VITE_BOTS_API_URL=http://localhost:8082
VITE_ENGINE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws
VITE_PREDICTION_API_URL=http://localhost:8084
VITE_PREDICTION_WS_URL=ws://localhost:8084/prediction/ws
VITE_PROPFIRM_URL=http://localhost:8090

# On-chain (Avalanche Fuji) — same values as Dex-Backend/.env.
VITE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
VITE_FUJI_CHAIN_ID=43113
VITE_DEXVAULT_ADDRESS=0x91E9AB30CFD444F857A5514197C1bd3b848c82eb
VITE_USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65
